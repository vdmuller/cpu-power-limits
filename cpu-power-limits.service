[Unit]
Description=Intel CPU MMIO power limits and optional undervolt offsets
After=systemd-suspend.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/libexec/cpu-power-limits --managed --profile auto --config /etc/cpu-power-limits.conf
RuntimeDirectory=cpu-power-limits
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
RemainAfterExit=yes
NotifyAccess=all
TimeoutStartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
